# Banco de dados (PostgreSQL - Supabase, schema "autocontrol" isolado)
# DATABASE_URL: connection string em modo pooling (porta 6543) - usada pela aplicação.
# DIRECT_URL: connection string direta (porta 5432) - usada pelo Prisma para migrations.
DATABASE_URL="postgresql://usuario:senha@host-pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://usuario:senha@host.supabase.com:5432/postgres"

# Autenticação
JWT_SECRET="troque-por-um-segredo-forte-aqui"
JWT_EXPIRES_IN="8h"

# Cloudinary (armazenamento de imagens) - crie uma conta gratuita em cloudinary.com
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Servidor
PORT=3333
NODE_ENV=development

# URL pública do frontend (usada para montar links de acompanhamento e CORS).
# Em produção, aponte para o domínio do Netlify (pode listar várias, separadas por vírgula).
FRONTEND_URL="http://localhost:5173"
